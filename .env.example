# PostgreSQL (Neon via Vercel sets this automatically). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Admin dashboard: random string, 32+ characters (e.g. `openssl rand -base64 48`).
AUTH_SECRET=

# First admin account, created by `npm run db:setup` (or the build) when no admins exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email notifications via Resend (https://resend.com). Leave empty to skip emails.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="Capital Youth Expo <noreply@capitalyouthexpo.com>"

# Photo uploads from the admin dashboard (Vercel Blob store). Optional: without it, use site image paths.
# Newer stores connected to the project set BLOB_STORE_ID (auth via Vercel OIDC); older ones set BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Public site address used for links and logos inside emails (defaults to the address the form was submitted on).
SITE_URL=https://capitalyouthexpo.com
